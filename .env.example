# Скопируйте этот файл в .env и заполните

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID юристов через запятую (свой ID можно узнать у @userinfobot)
LAWYER_IDS=

# Часовой пояс фирмы (по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow

# Напоминания клиенту, если он молчит (часы), не больше REMIND_MAX раз подряд,
# только с REMIND_FROM до REMIND_TO часов по времени фирмы
REMIND_AFTER_HOURS=48
REMIND_MAX=5
REMIND_FROM=10
REMIND_TO=20

# Напомнить нажать «Готово», если клиент прислал файлы и замолчал (минуты)
UNSUBMITTED_AFTER_MINUTES=30

# Демо-режим для витрины: каждый посетитель сам себе клиент и юрист, видит только свои данные,
# телефон не спрашивается, автоматических напоминаний нет. Для настоящей фирмы — false.
# В демо LAWYER_IDS — ваш ID: будут приходить уведомления о новых посетителях.
DEMO_MODE=false
